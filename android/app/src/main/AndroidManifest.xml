<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required at runtime, not just for the Flutter dev tool's debug
         connection — every real feature (the API, images, AdMob,
         OneSignal, App Links resolution) needs actual internet access.
         The debug-variant manifest (src/debug/AndroidManifest.xml) also
         declares this, but that override does NOT apply to release
         builds — leaving it out here meant release builds had zero
         network access at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Khhabar"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android App Links: khhabar.com/news/{slug} opens straight into
                 ArticleScreen instead of a browser, on any device where
                 https://khhabar.com/.well-known/assetlinks.json verifies this
                 app's signing certificate (autoVerify handles that check).
                 See DeepLinkService in lib/core/ for the Dart-side handling. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- pathPrefix is REQUIRED, not decoration. Without it this
                     filter claims EVERY khhabar.com URL, so the app becomes
                     the OS-verified handler for its own website — and any
                     launchUrl() to khhabar.com gets routed straight back
                     into the app instead of a browser. DeepLinkService only
                     understands /news/{slug} (extractArticleSlug returns
                     null for anything else) and silently drops the rest, so
                     "प्राइवेसी और सुरक्षा" and the Contact screen's website
                     row looked completely dead: tap, app catches its own
                     link, nothing happens, no error.

                     Fixing assetlinks.json on 2026-09-25 made this worse,
                     not better — once verification actually succeeded,
                     Android stopped falling back to a browser chooser.

                     /news/ is exactly what the app can handle, so that is
                     exactly what it should claim. Anything else on the
                     domain (/page/*, category pages, the site root) now
                     correctly opens in a browser. If DeepLinkService ever
                     learns to handle another path, add a second
                     <data> pathPrefix here for it. Don't widen this back
                     to the whole host. -->
                <data android:scheme="https" android:host="khhabar.com" android:pathPrefix="/news/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- AdMob App ID — TEST-MODE-APP-ID: this is Google's own public
             sample App ID (always serves test ads, never real revenue).
             Replace with the real App ID from your AdMob account (Apps ->
             App settings -> App ID) before a release build — see
             lib/core/ads/ad_config.dart, which needs the matching swap for
             ad unit IDs. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- REQUIRED for url_launcher to work at all on Android 11+ (API 30).
             Package visibility filtering hides every other installed app
             from this one unless the intent is declared here, so
             launchUrl() simply could not resolve a browser/mail/dialer and
             failed SILENTLY — no crash, no error, the tap just did nothing.

             This was a real, long-standing bug: "प्राइवेसी और सुरक्षा" and
             "ऐप को रेटिंग दें" in Account, the slider's external links, the
             WhatsApp share, and the Contact screen's email/phone/website
             rows were ALL dead on any Android 11+ device (this app targets
             SDK 36, so that's effectively every user). Reported 2026-09-25.

             Note the https entry is not optional just because the app uses
             https links rather than custom schemes — whatsapp_share.dart
             picked `wa.me` over `whatsapp://` specifically to dodge a
             queries entry, but VIEW+https is filtered exactly the same way.

             Scheme-per-need: https/http for web links (khhabar.com, wa.me,
             play.google.com, slider links), mailto for the contact email,
             tel for the contact phone number. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
